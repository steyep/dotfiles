#! /bin/sh

BRANCH_PATTERN="${1}"
if [[ "${BRANCH_PATTERN}" == "-" ]]; then
  BRANCH="${BRANCH_PATTERN}"
else
  BRANCH_MATCH=(
    $(git --no-pager branch \
      --list "*${BRANCH_PATTERN}*" \
      --ignore-case \
      --format='%(refname:short)' \
      --sort=-committerdate
    )
  )
  if [ ${#BRANCH_MATCH[@]} -gt 1 ]; then
    PS3="Choose a branch to checkout: "
    select BRANCH in ${BRANCH_MATCH[@]} Cancel; do
      case ${BRANCH} in
        Cancel) exit ${EXIT_USER_HALT} ;;
        *) break ;;
      esac
    done
  else
    BRANCH="${BRANCH_MATCH}"
  fi
fi

if [[ ! "${BRANCH}" ]]; then
  echo "No local branch matching '${BRANCH_PATTERN}'"
  exit 0
fi

git checkout "${BRANCH}"
