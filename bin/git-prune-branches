#! /bin/sh
PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
GIT_ROOT="${PROJECT_ROOT}/.git"
PLAN_FILE=${GIT_ROOT}/PRUNE_BRANCHES
cleanup() { test -f ${PLAN_FILE} && rm -f ${PLAN_FILE}; }
trap cleanup EXIT

test -d ${GIT_ROOT} || {
  echo "Could not find git directory: \"${GIT_ROOT}\"";
  exit 1;
}

ROOT_BRANCH="${1:-origin/develop}"
BRANCHES=()
test -f ${TMPFILE} && rm -f ${TMPFILE} 2> /dev/null

echo '# Branches to be removed on save & close' > ${PLAN_FILE}
while read LINE; do
  BRANCH="$(echo "${LINE}" | awk '{ print $1 }')"
  if [[ "${BRANCH}" == '*' || "$(echo "${BRANCH}" | grep -E 'main|master|develop')" ]]; then
    echo "Skipping branch ${LINE}" 1>&2
    continue;
  fi
  BRANCHES+=("${BRANCH}")
  echo "${LINE}" >> ${PLAN_FILE}
done <<< "$(git branch -vv --merged "${ROOT_BRANCH}")"

if (( ${#BRANCHES[@]} == 0 )); then
  echo "\033[0;32m\xE2\x9C\x94\033[0m No branches found that haven't been merged into ${ROOT_BRANCH}." 1>&2
  exit 0
fi

code --wait ${PLAN_FILE}
if [[ -f ${PLAN_FILE} ]]; then
  for BRANCH in ${BRANCHES[@]}; do
    if grep -q ${BRANCH} ${PLAN_FILE}; then
      git branch -D ${BRANCH}
    fi
  done
else
  echo "Unable to locate plan file: ${PLAN_FILE}" 1>&2
  exit 1
fi

exit 0
